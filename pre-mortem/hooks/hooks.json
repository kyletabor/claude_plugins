{
  "description": "Pre-mortem enforcement hooks — reminds agents to define criteria before delegation",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/check-premortem-on-delegation.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
